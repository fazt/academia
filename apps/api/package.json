{
  "name": "@academia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "stream:setup": "tsx --env-file-if-exists=.env scripts/stream-setup.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@academia/shared": "workspace:^",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-presigned-post": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@hono/node-server": "^2.1.3",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.9.1",
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "hono": "catalog:",
    "hono-openapi": "^1.3.3",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "resend": "^6.32.0",
    "stripe": "^23.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
