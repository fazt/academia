# --- Servidor ---
PORT=3011
NODE_ENV=development
# Origen público de la web (enlaces de emails, Stripe, Better Auth)
APP_URL=http://localhost:3010
DATABASE_URL=postgres://academia:academia@localhost:5437/academia
CURRENCY=USD

# --- Better Auth ---
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# false solo para desarrollo si no tienes Resend configurado
REQUIRE_EMAIL_VERIFICATION=true

# --- Microsoft (Entra ID) ---
# App registrada en Entra ID (ver README). Sin ID y secreto el botón de Microsoft no aparece.
# URI de redirección (Web): <APP_URL>/api/auth/callback/microsoft (en local http://localhost:3010/api/auth/callback/microsoft)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common = cuentas personales y de trabajo o escuela. También consumers, organizations o el ID de tu tenant.
MICROSOFT_TENANT_ID=common

# --- Resend ---
# Sin RESEND_API_KEY los emails se imprimen en la consola de la API
RESEND_API_KEY=
EMAIL_FROM="Academia <no-reply@tu-dominio.com>"

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Cloudflare Stream ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Subdominio de entrega: customer-<CODE>.cloudflarestream.com
STREAM_CUSTOMER_CODE=
# Los crea `pnpm stream:setup`
STREAM_SIGNING_KEY_ID=
STREAM_SIGNING_KEY_JWK=
STREAM_WEBHOOK_SECRET=

# --- DigitalOcean Spaces (S3 compatible) ---
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
# URL pública del bucket (o CDN) para portadas y avatares
SPACES_PUBLIC_URL=https://tu-bucket.nyc3.cdn.digitaloceanspaces.com

# --- Seed ---
SEED_ADMIN_EMAIL=admin@academia.test
SEED_ADMIN_PASSWORD=admin12345
